root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cc,cpp,h,hh,hpp}]
indent_style = space
indent_size = 4

[{CMakeLists.txt,*.cmake,*.cmake.in,*.sh}]
indent_style = space
indent_size = 4

[{*.json,*.jsonc,*.yml,*.yaml,*.md}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
