# Copy this file outside version control, point the paths at the vendor SDK,
# and select it from CMakeUserPresets.json.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

set(_sdk_root "/opt/vendor-sdk")
set(CMAKE_SYSROOT "${_sdk_root}/sysroots/target")
set(CMAKE_C_COMPILER "${_sdk_root}/bin/aarch64-vendor-linux-gcc")
set(CMAKE_CXX_COMPILER "${_sdk_root}/bin/aarch64-vendor-linux-g++")

set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
