# Doxygen configuration for the C++ Embedded Linux Repository Template.
# CMake configures this file; do not run it directly from the source tree.

DOXYFILE_ENCODING       = UTF-8
PROJECT_NAME           = "C++ Embedded Linux Repository Template"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "A production-minded C++20 template for embedded Linux"
OUTPUT_DIRECTORY       = "@PROJECT_BINARY_DIR@/doxygen"
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English

FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "@PROJECT_SOURCE_DIR@"
STRIP_FROM_INC_PATH    = "@PROJECT_SOURCE_DIR@/include"
SHORT_NAMES            = NO

JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO
INHERIT_DOCS           = YES
SEPARATE_MEMBER_PAGES  = NO
TAB_SIZE               = 4
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 4
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
CPP_CLI_SUPPORT        = NO

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_PRIV_VIRTUAL   = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO
HIDE_IN_BODY_DOCS      = NO

INPUT                  = "@PROJECT_SOURCE_DIR@/include" \
                         "@PROJECT_SOURCE_DIR@/src" \
                         "@PROJECT_SOURCE_DIR@/app" \
                         "@PROJECT_SOURCE_DIR@/README.md" \
                         "@PROJECT_SOURCE_DIR@/AGENTS.md" \
                         "@PROJECT_SOURCE_DIR@/CHANGELOG.md" \
                         "@PROJECT_SOURCE_DIR@/CODE_OF_CONDUCT.md" \
                         "@PROJECT_SOURCE_DIR@/CONTRIBUTING.md" \
                         "@PROJECT_SOURCE_DIR@/SECURITY.md" \
                         "@PROJECT_SOURCE_DIR@/SUPPORT.md" \
                         "@PROJECT_SOURCE_DIR@/docs"
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h \
                         *.hh \
                         *.hpp \
                         *.hxx \
                         *.c \
                         *.cc \
                         *.cpp \
                         *.cxx \
                         *.md
RECURSIVE              = YES
EXCLUDE                = "@PROJECT_SOURCE_DIR@/docs/_build"
EXCLUDE_SYMLINKS       = YES
EXCLUDE_PATTERNS       = */.git/* \
                         */build/* \
                         */_static/* \
                         */__pycache__/*
EXAMPLE_PATH           = "@PROJECT_SOURCE_DIR@/app"
EXAMPLE_RECURSIVE      = YES
USE_MDFILE_AS_MAINPAGE = "@PROJECT_SOURCE_DIR@/README.md"

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           = "@PROJECT_BINARY_DIR@/doxygen/warnings.log"

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = "@PROJECT_SOURCE_DIR@/include"

GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = YES

HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CLASS_DIAGRAMS         = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
UML_LOOK               = NO
